# ClipSync 生产环境配置模板
# 复制此文件为 .env 并填写实际值

# === 部署模式 ===
# http 或 https
DEPLOY_SCHEME=https

# === 数据库配置 ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=clipsync
DB_PASSWORD=your_secure_database_password_here
DB_NAME=clipsync

# === 安全配置 ===
# JWT 密钥（必须修改为随机字符串）
# 生成方法: openssl rand -hex 32
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here

# JWT 过期时间（分钟）
JWT_EXPIRE_MINUTES=10080

# === CORS 配置 ===
# 允许的前端域名（多个用逗号分隔）
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# === Cookie 安全 ===
# HTTPS 环境下设为 true
COOKIE_SECURE=true

# === HSTS ===
# HTTPS 环境下推荐启用
HSTS_ENABLED=true

# === 文件存储配置 ===
# 上传文件存储目录
UPLOAD_DIR=./uploads

# 默认用户配额（字节）
# 100MB = 104857600
# 1GB = 1073741824
DEFAULT_USER_QUOTA=1073741824

# === 限流配置 ===
# 登录接口限流（次/分钟）
RATE_LIMIT_LOGIN=5

# 注册接口限流（次/分钟）
RATE_LIMIT_REGISTER=3

# 访问码接口限流（次/分钟）
RATE_LIMIT_ACCESS=10

# === 日志配置 ===
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# === 其他配置 ===
# 分片大小（字节，1MB）
CHUNK_SIZE=1048576

# 访问码默认有效期（小时）
DEFAULT_ACCESS_CODE_EXPIRY=24
