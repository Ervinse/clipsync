# ClipSync 生产环境配置模板
# 复制为 backend/.env 并填写实际值。变量名必须与 backend/app/config.py 一致。

# === 数据库配置 ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=clipsync
DB_PASSWORD=
DB_NAME=clipsync

# === JWT ===
# 必填：用 `openssl rand -hex 32` 生成。少于 32 字符或仍是示例值时后端拒绝启动
JWT_SECRET=
JWT_ALGORITHM=HS256
# 令牌有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080

# === 部署模式（HTTP / HTTPS 切换）===
# DEPLOY_SCHEME、COOKIE_SECURE 为预留项，代码未读取（访问码链接按请求协议拼接，Token 不走 cookie）
DEPLOY_SCHEME=https
COOKIE_SECURE=true
# 只在 HTTPS 阶段设为 true；HTTP 内网阶段必须为 false
HSTS_ENABLED=true
# 允许的前端来源，逗号分隔，不支持通配符
CORS_ORIGINS=https://your-domain.com

# === 文件存储 ===
STORAGE_DIR=./storage
# 新用户默认配额（字节），100MB = 104857600；后台设置优先
DEFAULT_QUOTA_BYTES=104857600
# 单文件上限（字节），500MB
MAX_FILE_BYTES=524288000
# 单分片上限（字节），5MB；需小于 Nginx client_max_body_size
CHUNK_SIZE=5242880
# 单用户同时进行中的上传会话上限
MAX_UPLOAD_SESSIONS_PER_USER=5
# 未完成上传会话的过期时间（小时）
UPLOAD_SESSION_TTL_HOURS=24

# === 其他 ===
HISTORY_KEEP=50

# 限流阈值写在代码里（登录 10/分、注册 5/分、访问码 30/分），按客户端 IP 计数。
# 后端必须单 worker 运行，且反向代理与后端同机（uvicorn 只信任 127.0.0.1 的 X-Forwarded-For）。
