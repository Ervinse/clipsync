# ClipSync Docker Compose 环境变量：复制为 .env 后填写（cp .env.example .env && chmod 600 .env）
# 各项说明见 DEPLOYMENT.md「配置说明」。
# 值只用字母、数字和 _ - . @ : / ,：$ # 引号 空格 反斜杠在本文件里有特殊含义，会被截断或改写。
# 部署包更新时不会覆盖 .env；docker-compose.yml 与 nginx-*.conf 会被覆盖，需要调整的配置都在这里改。

# === 镜像版本 ===
# latest：最近一次从 master 打包的版本。
# 填提交号（如 1a2b3c4d5e6f）：使用该提交的镜像，用于部署非 master 分支的测试版本或回滚。
# 查看服务器上已导入的版本：docker images clipsync-backend
CLIPSYNC_TAG=latest

# === 端口 ===
# 网站端口（浏览器访问的端口）。启用 HTTPS 时必须保持 80
HTTP_PORT=80
# 数据库在宿主机上的端口：只绑定 127.0.0.1，外网连不进来，供 SSH 隧道查询数据库。
# 宿主机的 3306 已被占用时改成别的端口，如 3307
DB_HOST_PORT=3306

# === HTTPS ===
# 已用 cert.sh 申请到证书后取消下一行注释（步骤见 DEPLOYMENT.md「使用 HTTPS」）
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml

# === 数据库 ===
# 必填：两个密码留空时 docker compose 直接报错。生成随机密码：openssl rand -hex 16
# 账号在数据库第一次启动（数据卷为空）时创建，之后再改这里不会生效，反而会让后端连不上数据库
# DB_ROOT_PASSWORD 是数据库 root 账号的密码（用户名固定为 root）；DB_USER 不能取名 root
DB_ROOT_PASSWORD=
DB_NAME=clipsync
DB_USER=clipsync
DB_PASSWORD=

# === JWT ===
# 必填：用 openssl rand -hex 32 生成；少于 32 位或仍是示例值时后端拒绝启动。
# 修改后所有用户需要重新登录
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# === 访问地址 ===
# 浏览器地址栏里的地址：协议 + 域名或 IP + 非默认端口，多个用逗号分隔，不支持 *
# 例：http://203.0.113.10    http://203.0.113.10:8080    https://clipsync.example.com
CORS_ORIGINS=http://localhost
# HTTPS 生效后改为 true：浏览器之后一年内只用 HTTPS 访问本站，HTTP 阶段不要开
HSTS_ENABLED=false
# 预留项，代码未使用
DEPLOY_SCHEME=http
COOKIE_SECURE=false

# === 存储与上传（单位：字节）===
DEFAULT_QUOTA_BYTES=104857600
MAX_FILE_BYTES=524288000
# 单分片上限，不能超过 Nginx 的 client_max_body_size（10MB）
CHUNK_SIZE=5242880
MAX_UPLOAD_SESSIONS_PER_USER=5
UPLOAD_SESSION_TTL_HOURS=24

# === 剪贴板 ===
HISTORY_KEEP=50
