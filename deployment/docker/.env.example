# Docker Compose 环境变量配置

# === 数据库配置 ===
# 必填：两个密码留空时 docker compose 直接报错
# 密码只用字母、数字和 _ - . @，至少 12 位：$ # 引号 空格 反斜杠在本文件里有特殊含义，会被截断或改写
# 账号在数据库第一次启动（数据卷为空）时创建，之后再改这里不会生效，反而会让后端连不上数据库
# DB_ROOT_PASSWORD 是数据库 root 账号的密码（用户名固定为 root）；DB_USER 不能取名 root
DB_ROOT_PASSWORD=
DB_NAME=clipsync
DB_USER=clipsync
DB_PASSWORD=

# 数据库在宿主机上的端口：只绑定 127.0.0.1，外网连不进来，供 SSH 隧道查询数据库
# 宿主机的 3306 已被占用时改成别的端口，如 3307
DB_HOST_PORT=3306

# === JWT ===
# 必填：用 `openssl rand -hex 32` 生成，否则后端拒绝启动
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# === CORS 配置（前端实际访问地址，不支持通配符）===
CORS_ORIGINS=http://localhost

# === 部署配置 ===
DEPLOY_SCHEME=http
COOKIE_SECURE=false
HSTS_ENABLED=false

# === 存储与上传（单位：字节）===
DEFAULT_QUOTA_BYTES=104857600
MAX_FILE_BYTES=524288000
CHUNK_SIZE=5242880
MAX_UPLOAD_SESSIONS_PER_USER=5
UPLOAD_SESSION_TTL_HOURS=24

# === 剪贴板 ===
HISTORY_KEEP=50
