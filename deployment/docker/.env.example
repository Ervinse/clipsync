# Docker Compose 环境变量配置

# === 数据库配置 ===
DB_ROOT_PASSWORD=
DB_NAME=clipsync
DB_USER=clipsync
DB_PASSWORD=

# === JWT ===
# 必填：用 `openssl rand -hex 32` 生成，否则后端拒绝启动
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# === CORS 配置（前端实际访问地址，不支持通配符）===
CORS_ORIGINS=http://localhost

# === 部署配置 ===
DEPLOY_SCHEME=http
COOKIE_SECURE=false
HSTS_ENABLED=false
