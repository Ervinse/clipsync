# ClipSync 后端镜像
# 基础镜像版本号固定（Python 3.12 + Debian trixie），重新构建时运行环境不会悄悄变化；升级时手动改这里

FROM python:3.12.15-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 只装运行依赖（requirements.txt），测试依赖在 requirements-dev.txt，不进生产镜像。
# 不安装 gcc 等编译工具：这些依赖都有 manylinux x86_64 预编译包（aiomysql 为纯 Python），
# 新增依赖若没有预编译包，pip 会因缺编译器报错，届时再按需补装
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# 以非 root 用户运行；应用代码保持 root 所有（运行时只读），只有上传目录可写
RUN useradd --system --no-create-home clipsync \
    && mkdir -p storage \
    && chown clipsync storage
USER clipsync

EXPOSE 8000

# 单 worker：WebSocket 与限流依赖进程内存。docker-compose.yml 会用自己的 command 覆盖（先迁移再启动），
# 两处的 uvicorn 参数保持一致：只信任 compose 子网（172.28.0.0/16，即前端容器的 Nginx）发来的 X-Forwarded-For，
# WebSocket 单帧最大 4096 字节（客户端只发心跳，更大的帧在收完之前就被拒绝）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "172.28.0.0/16", "--ws-max-size", "4096"]
