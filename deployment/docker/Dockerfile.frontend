# ClipSync 前端镜像（多阶段构建）
# 基础镜像版本号固定，重新构建时运行环境不会悄悄变化；升级时手动改这里

# 构建阶段：Vite 8 要求 Node ^20.19.0 || >=22.12.0
FROM node:22.23.3-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# 运行阶段：Nginx 托管构建产物。站点配置由 docker-compose.yml 挂载（nginx-docker.conf / nginx-https.conf）
FROM nginx:1.30.5-alpine

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
