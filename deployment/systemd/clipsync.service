# ClipSync Systemd 服务配置
# 路径：/etc/systemd/system/clipsync.service

[Unit]
Description=ClipSync - 跨设备剪贴板与文件同步服务
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/clipsync/backend

# 虚拟环境路径
Environment="PATH=/var/www/clipsync/backend/venv/bin:$PATH"

# 从 .env 文件加载环境变量
EnvironmentFile=/var/www/clipsync/backend/.env

# 启动命令（使用 uvicorn）
# 必须单 worker：WebSocket 连接表与限流计数都在进程内存中，多 worker 会导致实时同步与限流失效
# 只监听 127.0.0.1：仅允许同机 Nginx 访问；uvicorn 默认只信任 127.0.0.1 发来的 X-Forwarded-For
ExecStart=/var/www/clipsync/backend/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1 \
    --log-level info \
    --access-log \
    --no-use-colors

# 重启策略
Restart=always
RestartSec=5s

# 资源限制
LimitNOFILE=65535

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clipsync

[Install]
WantedBy=multi-user.target
