# ClipSync Systemd 服务配置
# 路径：/etc/systemd/system/clipsync.service

[Unit]
Description=ClipSync - 跨设备剪贴板与文件同步服务
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/clipsync/backend

# 虚拟环境路径
Environment="PATH=/var/www/clipsync/backend/venv/bin:$PATH"

# 从 .env 文件加载环境变量
EnvironmentFile=/var/www/clipsync/backend/.env

# 启动命令（使用 uvicorn）
ExecStart=/var/www/clipsync/backend/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 4 \
    --log-level info \
    --access-log \
    --no-use-colors

# 重启策略
Restart=always
RestartSec=5s

# 资源限制
LimitNOFILE=65535

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clipsync

[Install]
WantedBy=multi-user.target
