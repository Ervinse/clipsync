# 数据库连接
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=clipsync

# JWT 认证
# 必填：用 `openssl rand -hex 32` 生成，至少 32 位；留空、过短、字符过于单一或示例值都会导致后端拒绝启动
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 部署
HSTS_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 存储
STORAGE_DIR=./storage
DEFAULT_QUOTA_BYTES=104857600
MAX_FILE_BYTES=524288000
# 单分片上限，不能超过 8388608（8MB），超过时后端拒绝启动
CHUNK_SIZE=5242880
MAX_UPLOAD_SESSIONS_PER_USER=5

# 其他
HISTORY_KEEP=50
UPLOAD_SESSION_TTL_HOURS=24
