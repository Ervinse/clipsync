# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=clipsync

# JWT authentication (MUST change JWT_SECRET to a long random string)
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Deployment config (HTTP / HTTPS switch)
DEPLOY_SCHEME=http
COOKIE_SECURE=false
HSTS_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
STORAGE_DIR=./storage
DEFAULT_QUOTA_BYTES=104857600
MAX_FILE_BYTES=524288000
CHUNK_SIZE=5242880

# Other
HISTORY_KEEP=50
UPLOAD_SESSION_TTL_HOURS=24
